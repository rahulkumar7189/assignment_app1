# MongoDB Atlas — get from https://cloud.mongodb.com → Connect → Drivers
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_DB_NAME=acadmate

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Razorpay — get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Platform fee (₹20 flat contact-unlock fee)
CONTACT_UNLOCK_FEE=20

# Default admin accounts (created on first startup if they don't exist)
ADMIN_1_EMAIL=admin@yourdomain.com
ADMIN_1_PASSWORD=change_this_to_a_strong_password
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=
