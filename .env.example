# MongoDB Atlas — get from https://cloud.mongodb.com → Connect → Drivers
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_DB_NAME=acadmate

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Razorpay — get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Payouts — required for auto-transfer to helper UPI after assignment payment
# Find in: Razorpay Dashboard → Settings → Account Number (looks like 2323230072660XXX)
# NOTE: Payouts require KYC-verified Razorpay account + Payouts feature enabled
RAZORPAY_ACCOUNT_NUMBER=your_razorpay_account_number

# Platform fee model
POSTING_FEE=9
PLATFORM_COMMISSION_PERCENT=10

# Default admin accounts (created on first startup if they don't exist)
ADMIN_1_EMAIL=admin@yourdomain.com
ADMIN_1_PASSWORD=change_this_to_a_strong_password
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=
